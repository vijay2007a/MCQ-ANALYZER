# Environment
ENVIRONMENT=development
PROJECT_NAME="Academic QuizMaster Pro API"
VERSION=1.0.0

# Database (PostgreSQL for Production, SQLite supported for Dev/Testing)
DATABASE_URL=postgresql://quiz_user:secure_password_here@localhost:5432/quizmaster_db
# For local SQLite dev:
# DATABASE_URL=sqlite:///./quizmaster.db

# Security & Secrets (Must be at least 32 characters in production)
SECRET_KEY=change-this-to-a-cryptographically-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
SESSION_EXPIRE_MINUTES=60

# Redis Cache & Rate Limiter (Optional - falls back to in-memory sliding window)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
