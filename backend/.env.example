# Environment
ENVIRONMENT=development
PROJECT_NAME="Academic QuizMaster Pro API"
VERSION=1.0.0

# Production defaults to Firebase Authentication and Firestore.
DATABASE_BACKEND=firestore
FIREBASE_PROJECT_ID=mcq-analyzer-16a47
# Vercel: set privately to a Firebase service-account JSON document. Never commit it.
# Local development can use gcloud auth application-default login instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional SQL mode for legacy installations and local tests only:
# DATABASE_BACKEND=sql
# DATABASE_URL=sqlite:///./quizmaster.db

# Required on first startup only; set privately to your chosen initial admin password.
# After provisioning, the audit guard preserves password changes without this value.
INITIAL_ADMIN_PASSWORD=

# Security & Secrets (Must be at least 32 characters in production)
SECRET_KEY=change-this-to-a-cryptographically-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
SESSION_EXPIRE_MINUTES=60

# Redis Cache & Rate Limiter (Optional - falls back to in-memory sliding window)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
